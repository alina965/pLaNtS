# For local Go run:
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydatabase?sslmode=disable
# For docker compose use host "postgres" instead of "localhost":
# DATABASE_URL=postgres://myuser:mypassword@postgres:5432/mydatabase?sslmode=disable
JWT_SECRET=change-me
ADDR=:8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=10